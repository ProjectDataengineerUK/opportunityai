# Backend — copie para .env e preencha
# Vertex AI usa Application Default Credentials (gcloud auth application-default login)
# Não é necessário GEMINI_API_KEY
GCP_PROJECT_ID=
GCP_LOCATION=us-central1

FREELANCER_CLIENT_ID=
FREELANCER_TOKEN=

# Upwork — API GraphQL oficial (OAuth2). Sem token, a fonte fica inativa.
UPWORK_TOKEN=
UPWORK_ORG_ID=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080

# Config
CONFIG_PATH=../config.yaml
